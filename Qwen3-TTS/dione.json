{
  "requirements": {
    "gpus": ["nvidia", "apple"],
    "os": ["windows", "linux", "darwin"]
  },
  "dependencies": {
    "git": { "version": "latest" },
    "uv": { "version": "latest" }
  },
  "installation": [
    {
      "name": "Cloning Qwen3-TTS repository",
      "commands": [
        "git clone https://github.com/SUP3RMASS1VE/Qwen3-TTS.git Qwen3-TTS"
      ]
    },
    {
      "name": "Installing SoX audio processor",
      "commands": [
        {
          "platform": "windows",
          "command": "powershell -Command \"winget install --id=ChrisBagwell.SoX -e --silent --accept-source-agreements --accept-package-agreements --force --disable-interactivity\""
        },
        {
          "platform": "linux",
          "command": "sudo apt-get install -y sox libsox-fmt-all"
        },
        {
          "platform": "darwin",
          "command": "brew install sox"
        }
      ]
    },
    {
      "name": "Installing requirements",
      "env": { "name": "venv", "version": "3.10", "type": "uv" },
      "commands": [
        "cd Qwen3-TTS",
        "uv pip install pip",
        "uv pip install -r requirements.txt"
      ]
    },
    {
      "name": "Installing PyTorch with CUDA support",
      "env": { "name": "venv", "version": "3.10", "type": "uv" },
      "commands": [
        "cd Qwen3-TTS",
        {
          "platform": "windows",
          "command": "uv pip install torch==2.7.0 torchvision==0.22.0 torchaudio==2.7.0 --index-url https://download.pytorch.org/whl/cu128 --force-reinstall --no-deps"
        },
        {
          "platform": "linux",
          "command": "uv pip install torch==2.7.0 torchvision==0.22.0 torchaudio==2.7.0 --index-url https://download.pytorch.org/whl/cu128 --force-reinstall"
        },
        {
          "platform": "darwin",
          "command": "uv pip install torch==2.7.0 torchvision==0.22.0 torchaudio==2.7.0 --force-reinstall --no-deps"
        }
      ]
    },
    {
      "name": "Installing triton",
      "env": { "name": "venv", "version": "3.10", "type": "uv" },
      "commands": [
        "cd Qwen3-TTS",
        {
          "platform": "windows",
          "command": "uv pip install triton-windows==3.3.1.post19"
        },
        {
          "platform": "linux",
          "command": "uv pip install triton"
        },
        {
          "platform": "darwin",
          "command": "echo Skipping triton on macOS - not required for MPS"
        }
      ]
    },
    {
      "name": "Installing Flash Attention",
      "env": { "name": "venv", "version": "3.10", "type": "uv" },
      "commands": [
        "cd Qwen3-TTS",
        {
          "platform": "windows",
          "command": "uv pip install https://huggingface.co/cocktailpeanut/wheels/resolve/main/flash_attn-2.8.2%2Bcu128torch2.7-cp310-cp310-win_amd64.whl"
        },
        {
          "platform": "linux",
          "command": "uv pip install https://huggingface.co/cocktailpeanut/wheels/resolve/main/flash_attn-2.8.3%2Bcu128torch2.7-cp310-cp310-linux_x86_64.whl"
        },
        {
          "platform": "darwin",
          "command": "echo Skipping Flash Attention on macOS - not supported on MPS"
        }
      ]
    }
  ],
  "start": [
    {
      "name": "Starting Qwen3-TTS",
      "catch": "7860",
      "env": "venv",
      "commands": [
        "cd Qwen3-TTS",
        {
          "platform": "darwin",
          "command": "python app_mac.py"
        },
        {
          "platform": "windows",
          "command": "python app.py"
        },
        {
          "platform": "linux",
          "command": "python app.py"
        }
      ]
    }
  ]
}
